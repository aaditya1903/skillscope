# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://skillscope:skillscope@localhost:5432/skillscope
FRONTEND_ORIGIN=http://localhost:5173

# Frozen evidence the API serves. The defaults are the evaluated corpus; the
# container stack points these at the generated demonstration evidence instead.
BM25_CONFIG_PATH=config/retrieval/bm25-v1.json
DENSE_CONFIG_PATH=config/retrieval/dense-hybrid-v1.json
EVALUATION_REPORT_PATH=reports/evaluation/method-comparison-test-v1.json

# Local Docker Compose database
POSTGRES_DB=skillscope
POSTGRES_USER=skillscope
POSTGRES_PASSWORD=skillscope
POSTGRES_PORT=5432
POSTGRES_TEST_PORT=5433

# Container demonstration stack
API_PORT=8000
FRONTEND_PORT=5173

# Add a separate fine-grained read-only token locally during ingestion work.
GITHUB_TOKEN=
