# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://skillscope:skillscope@localhost:5432/skillscope
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
FRONTEND_ORIGIN=http://localhost:5173

# Local Docker Compose database
POSTGRES_DB=skillscope
POSTGRES_USER=skillscope
POSTGRES_PASSWORD=skillscope
POSTGRES_PORT=5432

# Add a separate fine-grained read-only token locally during ingestion work.
GITHUB_TOKEN=
